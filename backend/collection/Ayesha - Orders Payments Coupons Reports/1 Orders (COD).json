              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Payment status is not accepted as order status',()=>pm.response.to.have.status(400));"
            ]
          }
