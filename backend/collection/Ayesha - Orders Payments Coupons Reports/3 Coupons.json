{
  "name": "3 Coupons",
  "item": [
    {
      "name": "List active coupons (public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/coupons"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Public active coupon list returns 200',()=>pm.response.to.have.status(200));",
              "pm.test('Coupon list is an array',()=>pm.expect(pm.response.json().data).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
