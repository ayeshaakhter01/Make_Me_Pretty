    {
      "name": "Create separate COD order for cancellation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{cancelRunKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "description": "Creates a second test order so the COD delivery and collection flow can remain intact. Cancellation restores the reserved stock.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"address\": {\n    \"recipientName\": \"Demo Customer\",\n    \"phone\": \"{{orderPhone}}\",\n    \"addressLine\": \"House 2, Road 1\",\n    \"area\": \"Dhanmondi\",\n    \"city\": \"Dhaka\"\n  },\n  \"paymentMethod\": \"cod\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('cancelRunKey', 'cod-cancel-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cancellation test order is created unpaid',()=>pm.response.to.have.status(201));if(pm.response.code===201){const d=pm.response.json().data;pm.collectionVariables.set('cancelOrderId',d._id);pm.test('Cancellation starts from pending states',()=>{pm.expect(d.status).to.eql('pending');pm.expect(d.paymentStatus).to.eql('pending');});}"
            ]
          }
        }
      ]
    },
