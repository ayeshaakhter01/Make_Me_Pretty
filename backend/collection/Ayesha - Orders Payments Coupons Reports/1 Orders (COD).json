            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Partner can advance assigned fulfillment status',()=>pm.response.to.have.status(200)); if(pm.response.code===200) pm.test('Shipping does not mark COD paid',()=>pm.expect(pm.response.json().data.paymentStatus).to.eql('pending'));"
            ]
          }
        }
      ]
    },
