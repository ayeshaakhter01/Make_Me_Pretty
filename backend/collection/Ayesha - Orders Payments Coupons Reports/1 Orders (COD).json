    },
    {
      "name": "Assign COD order to delivery partner (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orders/admin/{{orderId}}/assign-delivery",
        "description": "Requires adminToken and deliveryPartnerId.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deliveryPartnerId\": \"{{deliveryPartnerId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order assignment succeeds',()=>pm.response.to.have.status(200)); if(pm.response.code===200) pm.test('Assignment confirms fulfillment only; COD remains pending',()=>{pm.expect(pm.response.json().data.status).to.eql('confirmed');pm.expect(pm.response.json().data.paymentStatus).to.eql('pending');});"
            ]
          }
        }
      ]
    },
    {
      "name": "Advance assigned order to shipped (delivery partner)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{deliveryPartnerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/delivery/assignments/{{orderId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"shipped\"\n}",
          "options": {
