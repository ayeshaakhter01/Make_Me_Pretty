            "exec": [
              "pm.test('Customer can read own order',()=>pm.response.to.have.status(200)); if(pm.response.code===200){pm.test('COD is still pending before collection',()=>pm.expect(pm.response.json().data.paymentStatus).to.eql('pending'));}"
            ]
          }
        }
      ]
