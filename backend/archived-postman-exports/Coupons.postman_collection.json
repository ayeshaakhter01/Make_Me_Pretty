            "url": "{{baseUrl}}/api/coupons",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{couponTestCode}}\",\n  \"type\": \"percent\",\n  \"value\": 10,\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
