{
  "info": {
    "_postman_id": "b892d906-311b-41f4-b1f3-0d325392f218",
    "name": "Make Me Pretty - Coupons",
    "description": "Module-specific API checks for Make Me Pretty. Import this collection separately. Configure its own collection variables and credentials. Start with Setup & Authentication, then run the module folder. SSLCommerz tests contact the configured sandbox and never treat browser redirects as proof of payment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup & Authentication",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API is healthy', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope is present', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration returns 201 or duplicate 409', () => pm.expect([201,409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer login succeeds', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.environment.set('customerToken', pm.response.json().data.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?page=1&limit=24"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Catalog endpoint returns success', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const page = pm.response.json().data; pm.test('Product listing has the documented response shape', () => pm.expect(page.data).to.be.an('array')); const product = page.data?.find((item) => Number(item.stock) > 0); if (product && !pm.environment.get('productId')) pm.environment.set('productId', product._id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin credentials authenticate', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('adminToken', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login delivery partner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{deliveryEmail}}\",\n  \"password\": \"{{deliveryPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Delivery partner credentials authenticate', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('deliveryPartnerToken', pm.response.json().data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Coupons",
      "item": [
        {
          "name": "List active coupons (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/coupons"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Public active coupon list returns 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Coupon list is an array',()=>pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List all coupons (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/coupons/admin/all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin coupon list returns 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Admin coupon list is an array',()=>pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List coupons without authentication (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/coupons/admin/all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin coupon route requires authentication',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "List coupons as customer (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/coupons/admin/all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer cannot use admin coupon route',()=>pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create percent test coupon",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/coupons",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{couponTestCode}}\",\n  \"type\": \"percent\",\n  \"value\": 10,\n  \"active\": true,\n  \"note\": \"Postman coupon test\",\n  \"minOrderAmount\": 100,\n  \"expiresAt\": null,\n  \"usageLimit\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const code='MMP'+Date.now();pm.collectionVariables.set('couponTestCode',code);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin can create coupon',()=>pm.response.to.have.status(201));",
                  "if(pm.response.code===201){const d=pm.response.json().data;pm.collectionVariables.set('couponTestId',d._id);pm.test('Created coupon is persisted as percent',()=>{pm.expect(d.code).to.eql(pm.collectionVariables.get('couponTestCode'));pm.expect(d.type).to.eql('percent');pm.expect(d.usedCount).to.eql(0);});}"
                ]
              }
            }
          ]
        },
        {
          "name": "Validate percent coupon (public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/coupons/validate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{couponTestCode}}\",\n  \"subtotal\": 1000,\n  \"deliveryCharge\": 120\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Valid percent coupon returns 200',()=>pm.response.to.have.status(200));",
                  "if(pm.response.code===200){const d=pm.response.json().data;pm.test('Percent discount is calculated by server',()=>{pm.expect(d.itemDiscount).to.eql(100);pm.expect(d.deliveryDiscount).to.eql(0);pm.expect(d.totalDiscount).to.eql(100);});}"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject coupon below minimum subtotal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/coupons/validate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{couponTestCode}}\",\n  \"subtotal\": 50,\n  \"deliveryCharge\": 120\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
