    {
      "name": "Create percent test coupon",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/coupons",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{couponTestCode}}\",\n  \"type\": \"percent\",\n  \"value\": 10,\n  \"active\": true,\n  \"note\": \"Postman coupon test\",\n  \"minOrderAmount\": 100,\n  \"expiresAt\": null,\n  \"usageLimit\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const code='MMP'+Date.now();pm.collectionVariables.set('couponTestCode',code);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin can create coupon',()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201){const d=pm.response.json().data;pm.collectionVariables.set('couponTestId',d._id);pm.test('Created coupon is persisted as percent',()=>{pm.expect(d.code).to.eql(pm.collectionVariables.get('couponTestCode'));pm.expect(d.type).to.eql('percent');pm.expect(d.usedCount).to.eql(0);});}"
            ]
          }
        }
      ]
    },
    {
      "name": "Validate percent coupon (public)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/coupons/validate",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{couponTestCode}}\",\n  \"subtotal\": 1000,\n  \"deliveryCharge\": 120\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Valid percent coupon returns 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200){const d=pm.response.json().data;pm.test('Percent discount is calculated by server',()=>{pm.expect(d.itemDiscount).to.eql(100);pm.expect(d.deliveryDiscount).to.eql(0);pm.expect(d.totalDiscount).to.eql(100);});}"
            ]
          }
        }
      ]
    },
