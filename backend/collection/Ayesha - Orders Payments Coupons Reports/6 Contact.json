{
  "name": "6 Contact",
  "description": "Contact message API checks. Run 0 Setup first to fill customerToken and adminToken in the Local Environment.",
  "item": [
    {
      "name": "Submit Contact Us message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Contact Test\",\n  \"email\": \"postman-contact@example.com\",\n  \"phone\": \"\",\n  \"subject\": \"Contact API check\",\n  \"message\": \"This is a Postman check that Contact Us messages are saved for the admin team.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/contact-messages",
        "description": "Creates a real MongoDB contact message. It will remain in the admin inbox; the status update request below marks it resolved."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Contact message is accepted and saved',()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201){const id=pm.response.json().data.id;pm.collectionVariables.set('contactMessageTestId',id);pm.test('Server returns the saved message ID',()=>pm.expect(id).to.be.a('string').and.not.empty);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid Contact Us message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"message\": \"short\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/contact-messages"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid contact message is rejected with 400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Contact honeypot is quietly accepted without creating a message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"website\": \"filled-by-bot\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/contact-messages"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Honeypot gets a quiet accepted response',()=>pm.response.to.have.status(202));",
              "if(pm.response.code===202)pm.test('Response does not expose whether message was stored',()=>pm.expect(pm.response.json().data.accepted).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin Contact inbox rejects unauthenticated request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/contact-messages?status=new"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Contact inbox requires authentication',()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer cannot access Admin Contact inbox",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/contact-messages?status=new"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Contact inbox denies customer access',()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin lists Contact messages and finds saved test message",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/contact-messages?status=new"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin Contact inbox returns 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200){const data=pm.response.json().data;pm.test('Inbox contains a message array',()=>pm.expect(data).to.be.an('array'));const id=pm.collectionVariables.get('contactMessageTestId');if(id)pm.test('Newly submitted message appears in the database-backed inbox',()=>pm.expect(data.some(message=>message._id===id)).to.eql(true));}"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject unsupported Contact message status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"paid\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/admin/contact-messages/{{contactMessageTestId}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.collectionVariables.get('contactMessageTestId'))pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unsupported Contact status is rejected',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unauthenticated user cannot update Contact message",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"resolved\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/admin/contact-messages/{{contactMessageTestId}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.collectionVariables.get('contactMessageTestId'))pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Contact status update requires authentication',()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer cannot update Contact message",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"resolved\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/admin/contact-messages/{{contactMessageTestId}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.collectionVariables.get('contactMessageTestId'))pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Customer is forbidden from updating Contact status',()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Mark Postman Contact message resolved (admin)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"resolved\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/admin/contact-messages/{{contactMessageTestId}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.collectionVariables.get('contactMessageTestId'))pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin can update Contact message status',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200){const d=pm.response.json().data;pm.test('Resolved message has resolvedAt timestamp',()=>{pm.expect(d.status).to.eql('resolved');pm.expect(d.resolvedAt).to.exist;});pm.collectionVariables.unset('contactMessageTestId');}"
            ]
          }
        }
      ]
    }
  ],
  "collectionVariables": [
    {
      "key": "contactMessageTestId",
      "value": "",
      "type": "string"
    }
  ]
}
