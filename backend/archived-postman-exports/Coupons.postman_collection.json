                ]
              }
            }
          ]
        },
        {
          "name": "Update test coupon to fixed discount",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/coupons/{{couponTestId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"fixed\",\n  \"value\": 150\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Coupon can change to fixed amount',()=>pm.response.to.have.status(200));",
                  "if(pm.response.code===200)pm.test('Updated type and value are returned',()=>{pm.expect(pm.response.json().data.type).to.eql('fixed');pm.expect(pm.response.json().data.value).to.eql(150);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Validate fixed coupon discount",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/coupons/validate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{couponTestCode}}\",\n  \"subtotal\": 1000,\n  \"deliveryCharge\": 120\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Valid fixed coupon returns 200',()=>pm.response.to.have.status(200));",
                  "if(pm.response.code===200)pm.test('Fixed discount amount is applied',()=>pm.expect(pm.response.json().data.itemDiscount).to.eql(150));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update test coupon to shipping discount",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/coupons/{{couponTestId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"shipping\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Coupon can change to shipping discount',()=>pm.response.to.have.status(200));",
                  "if(pm.response.code===200)pm.test('Shipping coupon value is normalized to zero',()=>pm.expect(pm.response.json().data.value).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Validate shipping discount",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/coupons/validate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{couponTestCode}}\",\n  \"subtotal\": 1000,\n  \"deliveryCharge\": 120\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Valid shipping coupon returns 200',()=>pm.response.to.have.status(200));",
                  "if(pm.response.code===200){const d=pm.response.json().data;pm.test('Shipping discount applies to delivery only',()=>{pm.expect(d.itemDiscount).to.eql(0);pm.expect(d.deliveryDiscount).to.eql(120);pm.expect(d.totalDiscount).to.eql(120);});}"
                ]
              }
            }
          ]
        },
        {
          "name": "Deactivate test coupon",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
