{
  "info": {
    "_postman_id": "b0baf85d-a0c9-4be9-a546-e3a7062cfda5",
    "name": "Make Me Pretty - Payments",
    "description": "Module-specific API checks for Make Me Pretty. Import this collection separately. Configure its own collection variables and credentials. Start with Setup & Authentication, then run the module folder. SSLCommerz tests contact the configured sandbox and never treat browser redirects as proof of payment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup & Authentication",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API is healthy', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope is present', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration returns 201 or duplicate 409', () => pm.expect([201,409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer login succeeds', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.environment.set('customerToken', pm.response.json().data.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?page=1&limit=24"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Catalog endpoint returns success', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const page = pm.response.json().data; pm.test('Product listing has the documented response shape', () => pm.expect(page.data).to.be.an('array')); const product = page.data?.find((item) => Number(item.stock) > 0); if (product && !pm.environment.get('productId')) pm.environment.set('productId', product._id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin credentials authenticate', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('adminToken', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login delivery partner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{deliveryEmail}}\",\n  \"password\": \"{{deliveryPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Delivery partner credentials authenticate', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('deliveryPartnerToken', pm.response.json().data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Payments - SSLCommerz Sandbox",
      "item": [
        {
          "name": "SSLCommerz sandbox configuration",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payments/config"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Config endpoint reports sandbox state without secrets',()=>{pm.response.to.have.status(200);const body=pm.response.json();const d=body.data;pm.expect(d.environment).to.eql('sandbox');pm.expect(d.sslCommerzEnabled).to.be.a('boolean');pm.expect(JSON.stringify(body).toLowerCase()).not.to.match(/store_password|store_id/);pm.collectionVariables.set('sslCommerzEnabled',String(d.sslCommerzEnabled));});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create SSLCommerz order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{sslRunKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "description": "Requires a valid customer and product. SSLCommerz sandbox order total must be between ৳10 and ৳500,000.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"address\": {\n    \"recipientName\": \"Demo Customer\",\n    \"phone\": \"{{orderPhone}}\",\n    \"addressLine\": \"House 1, Road 1\",\n    \"area\": \"Dhanmondi\",\n    \"city\": \"Dhaka\"\n  },\n  \"paymentMethod\": \"sslcommerz\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('sslRunKey','ssl-order-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('SSLCommerz order is created pending',()=>pm.response.to.have.status(201)); if(pm.response.code===201){const d=pm.response.json().data;pm.collectionVariables.set('sslOrderId',d._id);pm.test('Order payment starts pending',()=>pm.expect(d.paymentStatus).to.eql('pending'));}"
                ]
              }
            }
          ]
        },
        {
          "name": "Initiate hosted SSLCommerz payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{sslPaymentKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/initiate",
            "description": "When configured, returns a hosted redirect URL. When not configured, expects 503 and does not mark the order paid.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{sslOrderId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "protocolProfileBehavior": {
              "followRedirects": false
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('sslPaymentKey')) pm.collectionVariables.set('sslPaymentKey', 'ssl-payment-' + Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.collectionVariables.get('sslCommerzEnabled')==='true'){pm.test('Session is initialized',()=>pm.response.to.have.status(201));if(pm.response.code===201){const d=pm.response.json().data;pm.collectionVariables.set('sslTransactionId',d.transactionId);pm.test('Redirect points to sandbox hosted checkout',()=>pm.expect(d.redirectUrl).to.match(/^https:\\/\\/sandbox\\.sslcommerz\\.com\\//));pm.test('Attempt returns unique identifiers',()=>{pm.expect(d.paymentId).to.be.a('string');pm.expect(d.transactionId).to.be.a('string');});}}else{pm.test('Unconfigured sandbox refuses initiation safely',()=>pm.response.to.have.status(503));}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Repeat SSLCommerz initiation with same idempotency key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{sslPaymentKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/initiate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{sslOrderId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "protocolProfileBehavior": {
              "followRedirects": false
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.collectionVariables.get('sslCommerzEnabled')==='true'){pm.test('Same attempt is reused',()=>pm.response.to.have.status(201));if(pm.response.code===201)pm.test('Transaction id is unchanged',()=>pm.expect(pm.response.json().data.transactionId).to.eql(pm.collectionVariables.get('sslTransactionId')));}else pm.test('Sandbox remains safely unavailable',()=>pm.response.to.have.status(503));"
                ]
              }
            }
          ]
        },
        {
          "name": "SSL initiation requires authentication",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "ssl-unauthorized-test-001"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/initiate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{sslOrderId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "protocolProfileBehavior": {
              "followRedirects": false
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthorized initiation is rejected',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "IPN rejects unknown transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/ipn",
            "description": "Form body: tran_id={{invalidTransactionId}}&val_id=fake-validation-id",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "tran_id",
                  "value": "{{invalidTransactionId}}"
                },
                {
                  "key": "val_id",
                  "value": "fake-validation-id"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unknown transaction cannot update an order',()=>pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Success browser callback handles unknown transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Origin",
                "value": "https://sandbox.sslcommerz.com"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/success",
            "description": "Uses an unknown tran_id. Requires SSLCommerz sandbox configuration for the result redirect.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "tran_id",
                  "value": "{{invalidTransactionId}}"
                },
                {
                  "key": "val_id",
                  "value": "fake-validation-id"
                },
                {
                  "key": "status",
                  "value": "VALID"
                }
              ]
            },
            "protocolProfileBehavior": {
              "followRedirects": false
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.collectionVariables.get(\"sslCommerzEnabled\")===\"true\"){pm.test(\"Invalid callback returns pending result redirect\",()=>pm.response.to.have.status(303));pm.test(\"Unverified callback cannot report success\",()=>pm.expect(pm.response.headers.get(\"Location\")||\"\").to.include(\"result=pending\"));}else pm.test(\"Callback redirect requires configured result URL\",()=>pm.response.to.have.status(503));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Failure browser callback handles unknown transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Origin",
                "value": "https://sandbox.sslcommerz.com"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/fail",
            "description": "Uses an unknown tran_id. Requires SSLCommerz sandbox configuration for the result redirect.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "tran_id",
                  "value": "{{invalidTransactionId}}"
                },
                {
                  "key": "val_id",
                  "value": "fake-validation-id"
                },
                {
                  "key": "status",
                  "value": "VALID"
                }
              ]
            },
            "protocolProfileBehavior": {
              "followRedirects": false
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.collectionVariables.get(\"sslCommerzEnabled\")===\"true\"){pm.test(\"Invalid callback returns pending result redirect\",()=>pm.response.to.have.status(303));pm.test(\"Unverified callback cannot report success\",()=>pm.expect(pm.response.headers.get(\"Location\")||\"\").to.include(\"result=pending\"));}else pm.test(\"Callback redirect requires configured result URL\",()=>pm.response.to.have.status(503));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Cancellation browser callback handles unknown transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Origin",
                "value": "https://sandbox.sslcommerz.com"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/cancel",
            "description": "Uses an unknown tran_id. Requires SSLCommerz sandbox configuration for the result redirect.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "tran_id",
                  "value": "{{invalidTransactionId}}"
                },
                {
                  "key": "val_id",
                  "value": "fake-validation-id"
                },
                {
                  "key": "status",
                  "value": "VALID"
                }
              ]
            },
            "protocolProfileBehavior": {
              "followRedirects": false
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.collectionVariables.get(\"sslCommerzEnabled\")===\"true\"){pm.test(\"Invalid callback returns pending result redirect\",()=>pm.response.to.have.status(303));pm.test(\"Unverified callback cannot report success\",()=>pm.expect(pm.response.headers.get(\"Location\")||\"\").to.include(\"result=pending\"));}else pm.test(\"Callback redirect requires configured result URL\",()=>pm.response.to.have.status(503));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "IPN rejects missing transaction ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/ipn",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "status",
                  "value": "VALID"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Malformed IPN is rejected',()=>pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Success browser callback verifies completed sandbox transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Origin",
                "value": "https://sandbox.sslcommerz.com"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/success",
            "description": "Run after completing the hosted sandbox checkout. This endpoint queries SSLCommerz by tran_id; posted status is intentionally omitted.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "tran_id",
                  "value": "{{sslTransactionId}}"
                }
              ]
            },
            "protocolProfileBehavior": {
              "followRedirects": false
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verified success callback returns to the payment result page',()=>pm.response.to.have.status(303));",
                  "const callbackLocation=new URL(pm.response.headers.get('Location')||'http://localhost');const result=callbackLocation.searchParams.get('result');const callbackOrderId=callbackLocation.searchParams.get('orderId');pm.test('Redirect reports only server-verified success or pending review',()=>pm.expect(['success','pending']).to.include(result));if(callbackOrderId)pm.collectionVariables.set('sslOrderId',callbackOrderId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Failure callback for real sandbox failed transaction (manual)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Origin",
                "value": "https://sandbox.sslcommerz.com"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/fail",
            "description": "Optional. Only run with an existing payment attempt whose actual SSLCommerz transaction failed. Set sslFailedTransactionId from that attempt. Backend queries the gateway; the submitted status is not trusted.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "tran_id",
                  "value": "{{sslFailedTransactionId}}"
                }
              ]
            },
            "protocolProfileBehavior": {
              "followRedirects": false
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verified failed callback redirects to the payment result page',()=>pm.response.to.have.status(303));",
                  "const callbackLocation=new URL(pm.response.headers.get('Location')||'http://localhost');const callbackOrderId=callbackLocation.searchParams.get('orderId');pm.test('Redirect result is failure',()=>pm.expect(callbackLocation.searchParams.get('result')).to.eql('failure'));if(callbackOrderId){pm.collectionVariables.set('sslFailedOrderId',callbackOrderId);pm.sendRequest({url:pm.variables.get('baseUrl')+'/api/orders/'+callbackOrderId,method:'GET',header:{Authorization:'Bearer '+pm.environment.get('customerToken')}},(error,response)=>{pm.test('failed callback order status can be checked by its owner',()=>{pm.expect(error).to.eql(null);pm.expect(response.code).to.eql(200);});if(!error&&response.code===200)pm.test('Server verified failed payment status',()=>pm.expect(response.json().data.paymentStatus).to.eql('failed'));});}else pm.test('Callback includes an order reference for status lookup',()=>pm.expect(callbackOrderId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancellation callback for real sandbox cancelled transaction (manual)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Origin",
                "value": "https://sandbox.sslcommerz.com"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/cancel",
            "description": "Optional. Only run with an existing payment attempt actually cancelled on SSLCommerz. Set sslCancelledTransactionId from that attempt. Backend queries the gateway; the submitted status is not trusted.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "tran_id",
                  "value": "{{sslCancelledTransactionId}}"
                }
              ]
            },
            "protocolProfileBehavior": {
              "followRedirects": false
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verified cancelled callback redirects to the payment result page',()=>pm.response.to.have.status(303));",
                  "const callbackLocation=new URL(pm.response.headers.get('Location')||'http://localhost');const callbackOrderId=callbackLocation.searchParams.get('orderId');pm.test('Redirect result is cancelled',()=>pm.expect(callbackLocation.searchParams.get('result')).to.eql('cancelled'));if(callbackOrderId){pm.collectionVariables.set('sslCancelledOrderId',callbackOrderId);pm.sendRequest({url:pm.variables.get('baseUrl')+'/api/orders/'+callbackOrderId,method:'GET',header:{Authorization:'Bearer '+pm.environment.get('customerToken')}},(error,response)=>{pm.test('cancelled callback order status can be checked by its owner',()=>{pm.expect(error).to.eql(null);pm.expect(response.code).to.eql(200);});if(!error&&response.code===200)pm.test('Server verified cancelled payment status',()=>pm.expect(response.json().data.paymentStatus).to.eql('cancelled'));});}else pm.test('Callback includes an order reference for status lookup',()=>pm.expect(callbackOrderId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify completed sandbox payment via IPN (manual)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/ipn",
            "description": "Only run after completing the hosted sandbox checkout. Set sslTransactionId to the transactionId returned by initiation. The app queries SSLCommerz by tran_id; the submitted status field is intentionally omitted.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "tran_id",
                  "value": "{{sslTransactionId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('SSLCommerz validates the transaction server-side',()=>pm.response.to.have.status(200));pm.test('IPN acknowledges verified callback',()=>pm.expect(pm.response.text()).to.eql('OK'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Repeat verified IPN (duplicate callback)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/ipn",
            "description": "Run after the manual verification request; provider validation must still return the same verified transaction.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "tran_id",
                  "value": "{{sslTransactionId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Repeated verified IPN is acknowledged safely',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check SSL order payment status after callback",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders/{{sslOrderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer can inspect the updated order',()=>pm.response.to.have.status(200));if(pm.response.code===200)pm.test('Payment remains pending for risk review or is paid after verification',()=>pm.expect(['pending','paid']).to.include(pm.response.json().data.paymentStatus));"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer cannot initiate payment for another customer order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "ssl-ownership-test-0001"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/initiate",
            "description": "Optional: set otherCustomerOrderId to an SSLCommerz order owned by a different customer. A 503 means sandbox configuration is absent and ownership check was not reached.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{otherCustomerOrderId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "protocolProfileBehavior": {
              "followRedirects": false
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order ownership is enforced',()=>pm.expect([404,503]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid SSLCommerz validation reference does not pay order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{baseUrl}}/api/payments/sslcommerz/ipn",
            "description": "Run only after Create SSLCommerz order and Initiate hosted SSLCommerz payment, before paying at the hosted checkout. Sends a fake validation reference and a forged callback status. The backend must ask SSLCommerz to validate it; this is a real provider request, not a mock. It does not simulate a provider amount/currency mismatch.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "tran_id",
                  "value": "{{sslTransactionId}}"
                },
                {
                  "key": "val_id",
                  "value": "POSTMAN-INVALID-VALIDATION-ID"
                },
                {
                  "key": "status",
                  "value": "VALID"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid provider validation reference is rejected',()=>pm.response.to.have.status(409));",
                  "pm.sendRequest({url:pm.variables.get('baseUrl')+'/api/orders/'+pm.collectionVariables.get('sslOrderId'),method:'GET',header:{Authorization:'Bearer '+pm.environment.get('customerToken')}},(error,response)=>{pm.test('Order status is readable after invalid callback',()=>{pm.expect(error).to.eql(null);pm.expect(response.code).to.eql(200);});if(!error&&response.code===200)pm.test('Forged callback status did not mark the payment paid',()=>pm.expect(response.json().data.paymentStatus).to.eql('pending'));});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Uses only implemented API routes. Callback request fields are untrusted; status changes come from SSLCommerz server-side validation. Live amount/currency mismatch tests require a provider validation response with mismatched data or a controlled database fixture; neither can be safely created through this public API/Postman collection."
    }
