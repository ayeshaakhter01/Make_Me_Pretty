{
  "name": "1 Orders (COD)",
  "item": [
    {
      "name": "Create COD order (server amount; starts pending)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{codRunKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "description": "Needs a valid productId with stock. The request includes forged totals/discounts; the server must ignore them.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"address\": {\n    \"recipientName\": \"Demo Customer\",\n    \"phone\": \"{{orderPhone}}\",\n    \"addressLine\": \"House 1, Road 1\",\n    \"area\": \"Dhanmondi\",\n    \"city\": \"Dhaka\"\n  },\n  \"paymentMethod\": \"cod\",\n  \"subtotal\": 1,\n  \"discount\": 999999,\n  \"total\": 1,\n  \"currency\": \"USD\",\n  \"paymentStatus\": \"paid\",\n  \"transactionId\": \"POSTMAN-FORGED-TRANSACTION\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('codRunKey', pm.collectionVariables.get('idempotencyKey') + '-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order is created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const d=pm.response.json().data; pm.collectionVariables.set('orderId',d._id); pm.collectionVariables.set('orderNumber',d.orderNumber); pm.test('Fulfillment and payment statuses are distinct',()=>{pm.expect(d.status).to.eql('pending');pm.expect(d.paymentStatus).to.eql('pending');}); pm.test('Server calculates nonnegative totals',()=>{pm.expect(d.subtotal).to.be.a('number');pm.expect(d.total).to.be.a('number');pm.expect(d.total).to.eql(d.subtotal+d.deliveryCharge-d.discount);}); }",
              "if(pm.response.code===201){const d=pm.response.json().data;pm.test('Client payment status/currency/transaction fields are ignored',()=>{pm.expect(d.paymentStatus).to.eql('pending');pm.expect(d.paymentMethod).to.eql('cod');});}"
            ]
          }
        }
      ]
    },
    {
      "name": "Replay same COD request (idempotent)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{codRunKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"address\": {\n    \"recipientName\": \"Demo Customer\",\n    \"phone\": \"{{orderPhone}}\",\n    \"addressLine\": \"House 1, Road 1\",\n    \"area\": \"Dhanmondi\",\n    \"city\": \"Dhaka\"\n  },\n  \"paymentMethod\": \"cod\",\n  \"subtotal\": 1,\n  \"discount\": 999999,\n  \"total\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Replay returns existing order successfully',()=>pm.expect([200,201]).to.include(pm.response.code)); if ([200,201].includes(pm.response.code)) { pm.test('No second order is created',()=>pm.expect(pm.response.json().data._id).to.eql(pm.collectionVariables.get('orderId'))); pm.test('Payment remains pending',()=>pm.expect(pm.response.json().data.paymentStatus).to.eql('pending')); }"
            ]
          }
        }
      ]
    },
