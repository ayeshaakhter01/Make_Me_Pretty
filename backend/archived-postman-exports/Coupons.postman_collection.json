        {
          "name": "Delete test coupon (cleanup)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/coupons/{{couponTestId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin can delete the temporary coupon',()=>pm.response.to.have.status(200));",
                  "if(pm.response.code===200){pm.collectionVariables.unset('couponTestId');pm.collectionVariables.unset('couponTestCode');}"
                ]
              }
            }
          ]
        }
