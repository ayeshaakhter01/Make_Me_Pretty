{
  "info": {
    "name": "Make Me Pretty API",
    "description": "Smoke test the API with local MongoDB. Set baseUrl, then run Health and Register/Login before authenticated requests. Register creates a customer; use admin:create to provision an admin and log in to test admin routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderNumber",
      "value": ""
    },
    {
      "key": "orderPhone",
      "value": "01700000000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('API is healthy', () => pm.response.to.have.status(200));",
              "pm.test('Success envelope is present', () => pm.expect(pm.response.json().success).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Customer\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"ChangeThisPassword123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Registration returns 201 or duplicate 409', () => pm.expect([201,409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"ChangeThisPassword123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Current user is authenticated', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "List products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products?page=1&limit=24"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Catalog endpoint returns success', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Add item to cart",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
        },
        "url": "{{baseUrl}}/api/cart/items"
      }
    },
    {
      "name": "Create COD order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 1 }],\n  \"address\": { \"recipientName\": \"Demo Customer\", \"phone\": \"{{orderPhone}}\", \"addressLine\": \"House 1, Road 1\", \"area\": \"Dhanmondi\", \"city\": \"Dhaka\" },\n  \"paymentMethod\": \"cod\"\n}"
        },
        "url": "{{baseUrl}}/api/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('COD order is created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('orderNumber', pm.response.json().data.orderNumber);"
            ]
          }
        }
      ]
    },
    {
      "name": "Own orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/orders/my"
      }
    },
    {
      "name": "Admin banners (admin token required)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/banners/admin/all"
      }
    },
    {
      "name": "Public blogs",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/blogs"
      }
    },
    {
      "name": "Invalid token is rejected",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer invalid"
          }
        ],
        "url": "{{baseUrl}}/api/orders/my"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Invalid token returns 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Track order",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/track/{{orderNumber}}?phone={{orderPhone}}"
      }
    }
  ]
}
